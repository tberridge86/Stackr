@@ -10,0 +11,12 @@ import { formatVariant, variantToIdentifier } from "./variantUtil.ts";
+function resolveAssetManifestKey(container: unknown, requestedKey: string, context: string): string | undefined {
+	if (!container || typeof container !== 'object' || Array.isArray(container)) return undefined
+	const keys = Object.keys(container)
+	if (keys.includes(requestedKey)) return requestedKey
+	const foldedRequestedKey = requestedKey.toLowerCase()
+	const matches = keys.filter((key) => key.toLowerCase() === foldedRequestedKey)
+	if (matches.length > 1) {
+		throw new Error(`Ambiguous TCGdex asset manifest ${context} key for ${requestedKey}: ${matches.join(', ')}`)
+	}
+	return matches[0]
+}
