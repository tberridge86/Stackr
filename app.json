{
  "expo": {
    "name": "Stackr",
    "slug": "Stackr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stackr",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Stackr needs camera access so you can scan your Pokémon cards.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Stackr needs camera access so you can scan your Pokémon cards."
        }
      ],
      "onnxruntime-react-native",
      [
        "@stripe/stripe-react-native",
        {}
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tommo86.Stackr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Stackr needs camera access so you can scan your Pokémon cards.",
        "NSLocationWhenInUseUsageDescription": "Stackr may use your location while the app is open to support location-based marketplace features, where available."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.tommo86.Stackr"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "22048198-a309-41d2-a2bf-aa354c76be3a"
      }
    }
  }
}
