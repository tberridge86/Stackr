{
  "expo": {
    "name": "Stackr",
    "slug": "Stackr",
    "version": "1.0.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/22048198-a309-41d2-a2bf-aa354c76be3a"
    },
    "orientation": "portrait",
    "icon": "./assets/rev2/01-brand/app/icon.png",
    "scheme": "stackr",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/rev2/01-brand/app/splash-ultra-hd.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Stackr needs camera access so you can scan your Pokemon cards.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Stackr needs camera access so you can scan your Pokémon cards.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Stackr needs camera access so you can scan your Pokémon cards."
        }
      ],
      "onnxruntime-react-native",
      [
        "@stripe/stripe-react-native",
        {}
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tommo86.Stackr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Stackr needs camera access so you can scan your Pokémon cards.",
        "NSLocationWhenInUseUsageDescription": "Stackr may use your location while the app is open to support location-based marketplace features, where available."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/rev2/01-brand/app/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 8,
      "package": "com.tommo86.Stackr"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/rev2/01-brand/app/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "22048198-a309-41d2-a2bf-aa354c76be3a"
      }
    }
  }
}
