# Server/worker-only values. Never put credentials in EXPO_PUBLIC_* variables.
# Supply a bucket-scoped R2 API token via the Railway secret store.
STACKR_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STACKR_R2_BUCKET=stackr-catalogue-public
STACKR_R2_ACCESS_KEY_ID=
STACKR_R2_SECRET_ACCESS_KEY=
# Custom public domain mapped to this exact bucket, not the S3 API endpoint.
STACKR_R2_PUBLIC_BASE_URL=https://assets.YOUR_DOMAIN

# Enable on both gateway and backend only after updated client rollout.
# The new client already requests <=50 rows; legacy bounds remain until then.
STACKR_ENFORCE_UI_PAGE_LIMIT=false
